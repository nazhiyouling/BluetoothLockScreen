<Window x:Class="BluetoothLockScreen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="720" Width="540"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/app.ico" ResizeMode="CanResizeWithGrip">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RSSI 阈值 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="RSSI锁屏阈值 (dBm):" VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="RssiThresholdBox" Width="80" VerticalAlignment="Center"/>
            <TextBlock Text="（负值，如 -83）" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- 期望设备名称 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="期望设备名称:" VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="ExpectedNameBox" Width="220" VerticalAlignment="Center"
                     ToolTip="与手机 APP 显示的蓝牙名称完全一致（区分大小写）"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="* 留空则首次启动不自动连接；填写后下次启动自动扫描并连接该名称设备"
                   FontSize="11" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- 手动地址 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="设备蓝牙地址:" VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="ManualAddressBox" Width="180" VerticalAlignment="Center"
                     ToolTip="可选，留空则自动扫描"/>
        </StackPanel>
        <TextBlock x:Name="TestResultText" Grid.Row="4" Text="" FontSize="12"
                   Foreground="DarkGreen" Margin="0,0,0,5"/>

        <!-- 高级时间参数 -->
        <GroupBox Grid.Row="5" Header="高级时间参数（秒）" Margin="0,5,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="连续低RSSI次数(次):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LowRssiCountBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="快速扫描冷却(秒):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="QuickScanCooldownBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="快速扫描超时(秒):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="QuickScanTimeoutBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="重连定时器间隔(秒):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ReconnectIntervalBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="连续断开次数(次):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DisconnectCountBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="看门狗超时(秒):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="PacketTimeoutBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="GATT关闭宽限期(秒):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="GattGraceBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="锁屏冷却(秒):"
                           VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="LockCooldownBox"
                         Margin="5,2" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="8"
                           Text="范围：次数 1~10，时间 1~300 秒。修改后立即生效。"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- 扫描区域 -->
        <StackPanel Grid.Row="6" Margin="0,0,0,0">
            <Button x:Name="ScanButton" Content="扫描候选设备" Height="30" Margin="0,0,0,5"
                    Click="ScanButton_Click"/>
            <ListBox x:Name="DeviceListBox" Height="100" SelectionChanged="DeviceListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding Rssi, StringFormat='{}{0} dBm'}" Foreground="Gray"/>
                            <TextBlock Text=")" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 保存/取消 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存设置" Width="100" Height="30" Click="SaveButton_Click"/>
            <Button Content="取消" Width="100" Height="30" Margin="10,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
